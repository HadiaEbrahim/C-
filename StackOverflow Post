using System;
using System.Collections.Generic;
using System.Diagnostics.Metrics;
using System.Linq;
using System.Text;
class post
{
    public DateTime Date { get; private set; }
    private string _title;
    private string _description;
    private int _vote;

    public int vote
    {
        get { return _vote; }
    }

    public int UpVote()
    {
        return _vote++;
    }
    public int DownVote()
    {
        return _vote--;

    }
   
    public string Description
    {
        get { return _description ; }
        set
        {
            if (string.IsNullOrEmpty(value))
            {
                throw new ArgumentException("value cannot be null or empty");
                
            }
            _description = value;
        }

    }
    public string Title
    {
        get { return _title; }
        set
        {
            if (string.IsNullOrEmpty(value))
            {
                throw new ArgumentException("value cannot be null or empty");
            }
            _title = value;

        }
    }
    public post(DateTime date, string title, string description)
    {
        Date = date;
        Title = title;
        Description = description;
        _vote = 0;
    }
}

internal class Program
{
    private static void Main(string[] args)
    {
        post post1 = new post(DateTime.Now, "First Post", "This is the first post.");
        do
        {
            Console.WriteLine($"Title: {post1.Title}");
            Console.WriteLine($"Description: {post1.Description}");
            Console.WriteLine($"Date: {post1.Date}");
            Console.WriteLine($"Votes: {post1.vote}");

            Console.WriteLine(" Up Vote press 1, Down Vote press 2, Exit press 0");
            int choice = Convert.ToInt32(Console.ReadLine());
            if (choice == 1)
            {
                post1.UpVote();
            }
            else if (choice == 2)
            {
                post1.DownVote();
            }
            else
            {
                return;
            }

            Console.Clear();
        } while (true);
    }
